{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "mobile-web",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["expo", "start", "--web", "--port", "8081"],
      "cwd": "apps/mobile",
      "port": 8081
    },
    {
      "name": "app-download-page",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "8090", "--directory", "deploy/www"],
      "port": 8090
    },
    {
      "name": "studio",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["next", "dev", "--port", "3000"],
      "cwd": "apps/studio",
      "port": 3000
    }
  ]
}
