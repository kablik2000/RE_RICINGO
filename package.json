{
  "name": "ricingo",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r run test",
    "verify": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm api:verify",
    "api:verify": "cd services/api && uv sync --locked && uv run ruff format --check . && uv run ruff check . && uv run mypy && uv run pytest -q",
    "backend:up": "docker compose up --build --detach",
    "backend:down": "docker compose down",
    "studio:dev": "pnpm --filter @ricingo/studio dev"
  },
  "devDependencies": {
    "eslint": "^10.15.0",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "@parcel/watcher"
    ]
  }
}
