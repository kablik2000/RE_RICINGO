  "grammarTopics": [
    {
      "id": "greetings",
      "title": "Pozdravy během dne",
      "summary": "Buongiorno se říká zhruba do odpoledne, buonasera odpoledne a večer. Při loučení zdvořile arrivederci, mezi přáteli ciao."
    },
    {
      "id": "formal-lei",
      "title": "Vykání (Lei)",
      "summary": "Italština vyká zájmenem Lei a slovesem ve 3. osobě jednotného čísla: Cosa desidera? = Co si přejete? V psaném textu se Lei často píše s velkým L."
    },
    {
      "id": "conditional-vorrei",
      "title": "Vorrei – zdvořilá žádost",
      "summary": "Vorrei je podmiňovací způsob (condizionale presente) slovesa volere. Odpovídá českému „chtěl/a bych“ a je zdvořilejší než přímé voglio (chci)."
    },
    {
      "id": "indefinite-article",
      "title": "Neurčitý člen",
      "summary": "Rod podstatného jména určuje člen: un pro mužský rod (un cappuccino), una pro ženský rod (una pizza). Před samohláskou se una zkracuje na un', mužský rod před s + souhláskou a z má uno."
    },
    {
      "id": "articulated-prepositions",
      "title": "Předložka + člen (al, alla…)",
      "summary": "Předložky se v italštině spojují se členem: a + il = al (al banco), a + la = alla (alla cassa). Stejně se chovají předložky di, da, in a su."
    },
    {
      "id": "essere-present",
      "title": "Sloveso essere (být)",
      "summary": "Nepravidelné sloveso: sono, sei, è, siamo, siete, sono. Pozor na rozdíl: è (je) s přízvukem je sloveso, e (a) je spojka."
    },
    {
      "id": "adjective-agreement",
      "title": "Shoda přídavného jména",
      "summary": "Přídavné jméno se shoduje s podstatným jménem v rodě i čísle: buono → buona giornata. Před podstatným jménem mužského rodu se buono zkracuje na buon (buon viaggio)."
    }
  ],
