# Static server of the student web app (ADR-0019), inside the rici-web image (Dockerfile.web).
# The proxy on the VPS (deploy/ricingo.caddy) terminates HTTPS, forwards /api/* to the API and
# everything else here.
{
	admin off
	auto_https off
}

:8080 {
	root * /srv
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Cross-Origin-Opener-Policy same-origin
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		# react-native-web sets inline styles; scripts, fonts, data and the API are all same-origin.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; manifest-src 'self'; worker-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'none'; object-src 'none'"
	}

	# Build files have content hashes in their names: cache them for good.
	@hashed path /_expo/static/* /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	# The entry points must always be checked, or students would keep an old version.
	@entry path / /index.html /sw.js /manifest.webmanifest
	header @entry Cache-Control "no-cache"
	header /sw.js Service-Worker-Allowed /

	# A single-page app: unknown paths are routes of the app.
	try_files {path} /index.html
	file_server
}
