{
  // RICINGO build & run tasks. Run with: Terminal → Run Task… (Ctrl+Shift+P → "Tasks: Run Task").
  // Default build task (Ctrl+Shift+B): "Android: build & run (local)" (native development build).
  // Default test task: "Verify (typecheck, lint, format, tests)".
  "version": "2.0.0",
  "options": {
    "cwd": "${workspaceFolder}"
  },
  "tasks": [
    {
      "label": "Install dependencies",
      "detail": "pnpm install for the whole workspace (pnpm via Corepack).",
      "type": "shell",
      "command": "corepack pnpm install",
      "problemMatcher": []
    },
    {
      "label": "Verify (typecheck, lint, format, tests)",
      "detail": "The same checks as CI. Run before committing.",
      "type": "shell",
      "command": "corepack pnpm verify",
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "Test",
      "type": "shell",
      "command": "corepack pnpm test",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Typecheck",
      "type": "shell",
      "command": "corepack pnpm typecheck",
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "Lint",
      "type": "shell",
      "command": "corepack pnpm lint",
      "problemMatcher": ["$eslint-stylish"]
    },
    {
      "label": "Format (Prettier)",
      "type": "shell",
      "command": "corepack pnpm format",
      "problemMatcher": []
    },
    {
      "label": "Expo Go: run on Android emulator",
      "detail": "Fastest way to run the app: no native build. Start the emulator first; Expo Go (SDK 58) is installed on it automatically.",
      "type": "shell",
      "command": "npx expo start --go --android",
      "options": { "cwd": "${workspaceFolder}/apps/mobile" },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Expo Go: start for a phone (QR code)",
      "detail": "Install Expo Go on the phone (same Wi-Fi as this PC) and scan the QR code shown in the terminal.",
      "type": "shell",
      "command": "npx expo start --go",
      "options": { "cwd": "${workspaceFolder}/apps/mobile" },
      "problemMatcher": []
    },
    {
      "label": "Start dev server (Metro)",
      "detail": "For a development build on a device/emulator. Keep it running; press r to reload.",
      "type": "shell",
      "command": "npx expo start",
      "options": { "cwd": "${workspaceFolder}/apps/mobile" },
      "problemMatcher": []
    },
    {
      "label": "Start web preview",
      "detail": "Browser preview at http://localhost:8081 (development only).",
      "type": "shell",
      "command": "npx expo start --web",
      "options": { "cwd": "${workspaceFolder}/apps/mobile" },
      "problemMatcher": []
    },
    {
      "label": "Android: start emulator",
      "detail": "Boots an Android Virtual Device from Android Studio.",
      "type": "shell",
      "command": "& \"${env:ANDROID_HOME}/emulator/emulator.exe\" -avd ${input:androidAvd}",
      "options": {
        "shell": { "executable": "powershell.exe", "args": ["-NoProfile", "-Command"] }
      },
      "problemMatcher": []
    },
    {
      "label": "Android: build & run (local)",
      "detail": "Native development build with Gradle, installed on the running emulator/device; starts Metro. First build ~15 min, later builds are incremental. Windows: needs long paths + SDK CMake 3.31.6 (see README).",
      "type": "shell",
      "command": "npx expo run:android",
      "options": { "cwd": "${workspaceFolder}/apps/mobile" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Android: build release APK (local)",
      "detail": "Release build for testing on devices. Signed with the debug key — not for store upload.",
      "type": "shell",
      "command": "npx expo run:android --variant release --no-bundler",
      "options": { "cwd": "${workspaceFolder}/apps/mobile" },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Android: regenerate native project",
      "detail": "Clean prebuild of apps/mobile/android after changing app.config.ts or native dependencies.",
      "type": "shell",
      "command": "npx expo prebuild --platform android --clean",
      "options": { "cwd": "${workspaceFolder}/apps/mobile" },
      "problemMatcher": []
    },
    {
      "label": "EAS: development build (cloud)",
      "detail": "Cloud build via EAS. Requires an Expo account and an initialised EAS project (DEVELOPMENT_PLAN Q-16). iOS builds are only possible this way on Windows.",
      "type": "shell",
      "command": "npx eas-cli@latest build --profile development --platform ${input:platform}",
      "options": { "cwd": "${workspaceFolder}/apps/mobile" },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "EAS: preview build (cloud)",
      "detail": "Internal-distribution build for testers (APP_ENV=preview).",
      "type": "shell",
      "command": "npx eas-cli@latest build --profile preview --platform ${input:platform}",
      "options": { "cwd": "${workspaceFolder}/apps/mobile" },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Export JS bundles (Android, iOS, web)",
      "detail": "Bundles all platforms without native compilation (same check as CI).",
      "type": "shell",
      "command": "npx expo export --platform all --output-dir dist",
      "options": { "cwd": "${workspaceFolder}/apps/mobile" },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Expo doctor",
      "detail": "Checks dependency versions and app config against the Expo SDK.",
      "type": "shell",
      "command": "npx expo-doctor",
      "options": { "cwd": "${workspaceFolder}/apps/mobile" },
      "problemMatcher": []
    },
    {
      "label": "Teacher Studio (web administrace): start",
      "detail": "Teacher Studio (Next.js) at http://localhost:3000, from other devices on the home network http://<PC IP>:3000. Start the backend first (Backend: start) for live data.",
      "type": "shell",
      "command": "corepack pnpm studio:dev",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Backend: start (Docker)",
      "detail": "PostgreSQL, Mailpit and the Flask API in Docker. API http://localhost:8000/api/v1/health, mail http://localhost:8025.",
      "type": "shell",
      "command": "docker compose up --build",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Backend: stop (Docker)",
      "detail": "Stops the backend containers; database data is kept.",
      "type": "shell",
      "command": "docker compose down",
      "problemMatcher": []
    },
    {
      "label": "Backend: reset database (Docker)",
      "detail": "Stops the backend and DELETES the local development database volume.",
      "type": "shell",
      "command": "docker compose down --volumes",
      "problemMatcher": []
    },
    {
      "label": "Teacher Studio: create a teacher account",
      "detail": "Creates a sign-in for the Studio (backend must run). The password is asked for in the terminal and not shown; at least 15 characters.",
      "type": "shell",
      "command": "docker compose exec api flask --app rici_api.wsgi create-teacher ${input:teacherEmail} --name \"${input:teacherName}\" --organization \"${input:organization}\"",
      "problemMatcher": []
    },
    {
      "label": "Teacher Studio: set a new password",
      "detail": "Replaces a teacher's password and signs the account out everywhere (backend must run).",
      "type": "shell",
      "command": "docker compose exec api flask --app rici_api.wsgi set-password ${input:teacherEmail}",
      "problemMatcher": []
    },
    {
      "label": "Backend: tests and checks (Python)",
      "detail": "Ruff, mypy and pytest for services/api (no Docker needed).",
      "type": "shell",
      "command": "corepack pnpm api:verify",
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "teacherEmail",
      "type": "promptString",
      "description": "Teacher's e-mail (the sign-in name)"
    },
    {
      "id": "teacherName",
      "type": "promptString",
      "description": "Name shown in the Studio"
    },
    {
      "id": "organization",
      "type": "promptString",
      "description": "Organization (school); created if new",
      "default": "RICI"
    },
    {
      "id": "androidAvd",
      "type": "promptString",
      "description": "Android Virtual Device name (list them with: emulator -list-avds)",
      "default": "Pixel_3a_API_34_extension_level_7_x86_64"
    },
    {
      "id": "platform",
      "type": "pickString",
      "description": "Target platform",
      "options": ["android", "ios"],
      "default": "android"
    }
  ]
}
