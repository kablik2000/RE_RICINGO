# Caddy site config for RICI (ADR-0015), copied to /srv/proxy/sites/ by deploy.sh.
# Caddy obtains and renews the HTTPS certificates itself (the DNS names must point to the VPS).
# By default Caddy replaces any X-Forwarded-For a client sends with the client's own address.

rici.esprog.eu {
	encode zstd gzip

	# Download page for the student app (deploy/www/app, copied to /srv/www/rici-app; the APK is
	# uploaded next to it by hand, docs/setup/ANDROID_APK.md). Everything else is the Studio.
	redir /app /app/ 308
	handle_path /app/* {
		root * /srv/www/rici-app
		@apk path *.apk
		header @apk Content-Type application/vnd.android.package-archive
		header @apk Content-Disposition "attachment; filename=\"italstina-rici.apk\""
		header @apk Cache-Control "no-cache"
		header X-Content-Type-Options nosniff
		header Referrer-Policy same-origin
		header Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'none'"
		file_server
	}

	handle {
		reverse_proxy 127.0.0.1:3100
	}
}

api.rici.esprog.eu {
	encode zstd gzip
	reverse_proxy 127.0.0.1:8100
}

# The student web app (ADR-0019). The API is served on the same origin, so the app needs no
# cross-origin requests and its Content Security Policy can stay 'self' only.
app.rici.esprog.eu {
	encode zstd gzip

	handle /api/* {
		reverse_proxy 127.0.0.1:8100
	}

	handle {
		reverse_proxy 127.0.0.1:3200
	}
}
